{
  "version": 1,
  "safety_margins": {
    "EN": {
      "max_likes_per_day": 30,
      "max_replies_per_day": 0,
      "max_follows_per_day": 5,
      "max_targets_per_day": 5
    },
    "JP": {
      "max_likes_per_day": 15,
      "max_replies_per_day": 0,
      "max_follows_per_day": 2,
      "max_targets_per_day": 3
